rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Dev = existe documento devs/{uid}. Criado só pelo Console/Admin SDK.
    function isSignedIn() { return request.auth != null; }
    function isDev() {
      return isSignedIn() && exists(/databases/$(database)/documents/devs/$(request.auth.uid));
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Cada usuário só vê o próprio documento em devs (necessário para isDev() no cliente).
    match /devs/{uid} {
      allow get: if isOwner(uid);
      allow list, write: if false;
    }

    // Perfil e subcoleções (refeicoes, agua, dashboard, ...): dono lê/escreve; dev só lê.
    match /users/{uid} {
      allow read: if isOwner(uid) || isDev();
      allow write: if isOwner(uid);

      match /{subcollection}/{docId=**} {
        allow read: if isOwner(uid) || isDev();
        allow write: if isOwner(uid);
      }
    }

    // Logs da API: só devs leem; escrita pelo backend (Admin SDK ignora regras).
    match /logs/{logId} {
      allow read: if isDev();
      allow write: if false;
    }
  }
}
